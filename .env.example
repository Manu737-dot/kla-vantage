# Part 2 (optional). Copy to .env and fill in only the keys you have.
# .env is git-ignored. Keys are only ever sent in request headers.
#
# Google AI Studio key (free tier):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter key (":free" models only): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq key (free plan):               https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI key (PAID, opt-in):            https://platform.openai.com/api-keys
# Used only while ai.providers.openai.opt_in is true in config.yaml, with a hard
# $1.00 total cap (spend_cap_usd). Leave empty to never call OpenAI.
OPENAI_API_KEY=
